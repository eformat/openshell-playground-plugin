# OpenShell Gateway — dev build
# Build: podman build -t quay.io/eformat/openshell-gateway:0.0.95-dev -f images/Containerfile.gateway images/
# Push: podman push quay.io/eformat/openshell-gateway:0.0.95-dev
FROM debian:bookworm-slim

RUN apt-get update -qq && \
    apt-get install -y -qq libz3-4 libgmp10 libstdc++6 libgcc-s1 2>/dev/null && \
    rm -rf /var/lib/apt/lists/*

COPY openshell-gateway /usr/local/bin/openshell-gateway
RUN chmod +x /usr/local/bin/openshell-gateway

USER 1000:1000
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/openshell-gateway"]
CMD ["--bind-address", "0.0.0.0", "--port", "8080"]
